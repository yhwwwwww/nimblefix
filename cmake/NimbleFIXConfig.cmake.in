@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@NIMBLEFIX_ENABLE_TLS@)
    find_dependency(OpenSSL 1.1.1)
endif()
if(@NIMBLEFIX_ENABLE_XML@)
    find_dependency(LibXml2 2.9)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NimbleFIXTargets.cmake")
set(NIMBLEFIX_SCHEMA_GENERATOR NimbleFIX::nimblefix-schema-gen)
include("${CMAKE_CURRENT_LIST_DIR}/NimbleFIXSchema.cmake")
set(NimbleFIX_core_FOUND TRUE)
set(NimbleFIX_tls_FOUND @NIMBLEFIX_ENABLE_TLS@)
set(NimbleFIX_io_uring_FOUND @NIMBLEFIX_ENABLE_IO_URING@)
set(NimbleFIX_xml_FOUND @NIMBLEFIX_ENABLE_XML@)
set(NimbleFIX_cli_FOUND @NIMBLEFIX_BUILD_CLI@)
set(NimbleFIX_TLS_ENABLED @NIMBLEFIX_ENABLE_TLS@)
set(NimbleFIX_IO_URING_ENABLED @NIMBLEFIX_ENABLE_IO_URING@)
set(NimbleFIX_XML_ENABLED @NIMBLEFIX_ENABLE_XML@)
foreach(standard fix42 fix43 fix44 fixt11 fix50sp2)
    if(TARGET NimbleFIX::${standard})
        set(NimbleFIX_${standard}_FOUND TRUE)
    endif()
endforeach()
if(TARGET NimbleFIX::fix44_sample)
    set(NimbleFIX_sample_FOUND TRUE)
endif()
check_required_components(NimbleFIX)
